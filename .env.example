# ── Reckless Lab — storefront configuration ────────────────────────────
# Copy this file to `.env.local` and fill in real values.
# Everything here is public (NEXT_PUBLIC_*) — no secrets.

# Business WhatsApp line that receives orders. Digits only, incl. country code.
# The Gambia country code is 220.
NEXT_PUBLIC_WHATSAPP_NUMBER=2207000000
NEXT_PUBLIC_WHATSAPP_LABEL="+220 700 0000"

# Store currency shown across the site.
NEXT_PUBLIC_CURRENCY_CODE=USD
NEXT_PUBLIC_CURRENCY_SYMBOL=$

# Social + contact
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/be_reck1ess
NEXT_PUBLIC_CONTACT_EMAIL=studio@recklesslab.com

# ── Auth ───────────────────────────────────────────────────────────────
# Secret used to sign session cookies (JWT). Generate a long random string:
#   openssl rand -base64 32
# CHANGE THIS before deploying. If unset, a dev fallback is used.
AUTH_SECRET=change-me-to-a-long-random-string

# Seed admin account, created automatically on first run. CHANGE THE PASSWORD.
ADMIN_EMAIL=admin@recklesslab.com
ADMIN_PASSWORD=reckless2026
