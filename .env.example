# ── Reckless Lab — configuration ───────────────────────────────────────
# Copy this file to `.env.local` and fill in real values.

# ── Database (PostgreSQL — Neon in production) ─────────────────────────
# Local dev:  postgresql://USER@localhost:5432/reckless?schema=public
# Production: your Neon pooled connection string.
DATABASE_URL="postgresql://user@localhost:5432/reckless?schema=public"

# ── Media (Vercel Blob) ────────────────────────────────────────────────
# From the Vercel dashboard → Storage → Blob. Needed for media uploads.
BLOB_READ_WRITE_TOKEN=



# Business WhatsApp that receives orders ("Big Saul"). Digits only, incl. code.
NEXT_PUBLIC_WHATSAPP_NUMBER=2203449999
NEXT_PUBLIC_WHATSAPP_LABEL="+220 344 9999"

# Store currency shown across the site.
NEXT_PUBLIC_CURRENCY_CODE=USD
NEXT_PUBLIC_CURRENCY_SYMBOL=$

# Social + contact
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/be_reck1ess
NEXT_PUBLIC_CONTACT_EMAIL=studio@recklesslab.com

# ── Auth ───────────────────────────────────────────────────────────────
# Secret used to sign session cookies (JWT). Generate a long random string:
#   openssl rand -base64 32
# CHANGE THIS before deploying. If unset, a dev fallback is used.
AUTH_SECRET=change-me-to-a-long-random-string

# Seed admin account, created by `npm run db:seed`. CHANGE THE PASSWORD.
ADMIN_EMAIL=admin@recklesslab.com
ADMIN_PASSWORD=reckless2026
